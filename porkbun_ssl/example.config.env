# === Porkbun SSL Settings ===
DOMAIN="example.com"
API_KEY="pk1_your_api_key"
SECRET_KEY="sk1_your_secret_key"
CERT_PATH="/root/certs"
CERT_NAME="cert.pem"
KEY_NAME="privkey.key"
DAYS_THRESHOLD="7"

# === Post-update Hooks (Commands to run after cert update) ===
# Bash commands executed sequentially after certificates are successfully saved.
# Defined as an array: POST_COMMANDS=( ... ).
# If the list is empty or commented out, no post-update commands will be executed.

# Example 1: Nginx (syntax check and graceful reload)
POST_COMMANDS=(
    "nginx -t"
    "sudo systemctl reload nginx"
)

# Example 2: HAProxy (often requires a combined fullchain + key PEM bundle)
# POST_COMMANDS=(
#     "cat /root/certs/cert.pem /root/certs/privkey.key > /etc/haproxy/certs/bundle.pem"
#     "chmod 600 /etc/haproxy/certs/bundle.pem"
#     "haproxy -c -f /etc/haproxy/haproxy.cfg"
#     "sudo systemctl reload haproxy"
# )

# Example 3: Docker containers
# POST_COMMANDS=(
#     "docker restart my_nginx_or_haproxy"
# )
